# Netlify headers for www.bsworks.store (works with drag-and-drop and Git deploys)
# Keep this file name exactly: _headers (no .txt)

# Images and other files in /assets/ are cached by browsers for 30 days.
# When you replace an image, give the new file a new name (e.g. logo-v2.png).
/assets/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/favicon-96.png
  Cache-Control: public, max-age=2592000

# Self-hosted libraries live in version-numbered folders (e.g. gsap-3.13.0), so a file at a given URL never changes
# and browsers may keep it for a year. To upgrade, add a NEW folder (gsap-3.14.0) and point the <script> tags at it.
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Basic security headers for every page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Versioned homepage resources: update the filename in index.html when changing these.
/css/home.20261103.css
  Cache-Control: public, max-age=31536000, immutable

/js/home.20261103.js
  Cache-Control: public, max-age=31536000, immutable

# pages.css is not versioned; revalidate to avoid stale styles after deployments.
/css/pages.css
  Cache-Control: public, max-age=0, must-revalidate

/css/site-footer.20261103.css
  Cache-Control: public, max-age=31536000, immutable
